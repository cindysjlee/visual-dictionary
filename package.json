{
  "name": "security-cs-visual-dictionary",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "validate": "node scripts/validate-content.ts",
    "build:content": "node scripts/build-index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && npm run build -w apps/web",
    "deploy": "npm run build && npm exec -w infra -- cdk deploy --all --profile vd",
    "test": "vitest run",
    "test:e2e": "npm run typecheck && npm run build:e2e -w apps/web && playwright test",
    "test:e2e:drafts": "node scripts/e2e-drafts.ts",
    "check:bundle": "node scripts/check-bundle.ts",
    "verify": "npm run validate && npm test && npm run build && npm run check:bundle",
    "smoke:prod": "node scripts/smoke-prod.ts",
    "smoke:auth": "node scripts/smoke-auth.ts",
    "smoke:auth:signup": "node scripts/smoke-auth-signup.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
