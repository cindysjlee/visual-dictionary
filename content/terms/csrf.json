            "checks": [
              {
                "name": "쿠키",
                "result": "있음",
                "status": "ok"
              },
              {
                "name": "CSRF 토큰",
                "result": "검사 안 함",
                "status": "skip"
              }
            ]
          }
        ]
      },
      {
        "action": "send",
        "from": "bank",
        "to": "evilTab",
        "title": "송금 완료",
        "label": "200 OK · 송금 완료",
        "caption": "은행은 본인이 보낸 요청이라고 판단해 송금을 처리하고, 응답은 요청을 보낸 함정 탭으로 돌아갑니다. 함정 사이트는 응답 내용을 읽을 수 없지만 송금은 이미 끝났고, 돈이 공격자 계좌로 빠져나갑니다. 사용자는 아무것도 누르지 않았습니다.",
        "danger": true,
        "effects": [
          {
            "type": "transfer",
            "item": "coin",
            "from": "bank",
            "to": "attacker",
            "amount": 1000000
          }
        ]
      }
