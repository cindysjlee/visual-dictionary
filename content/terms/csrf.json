      {
        "id": "evil",
        "name": "함정 사이트 서버",
        "role": "server",
        "kind": "server",
        "zone": "server",
        "site": "evil.example",
        "tone": "attack"
      },
      {
        "id": "attacker",
        "name": "공격자",
        "role": "attacker",
        "kind": "attacker",
        "zone": "outside"
      }
