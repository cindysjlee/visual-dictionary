  "defenses": [
    {
      "name": "CSRF 토큰",
      "kind": "defense",
      "description": "서버가 폼마다 예측할 수 없는 토큰을 넣어 두고, 요청에 같은 토큰이 있는지 확인합니다. 함정 사이트는 이 값을 알 수 없어 위조 요청이 거부됩니다.",
      "blockedAtStep": 5,
      "blockedTitle": "위조 요청 차단",
      "blockedLabel": "403 · 토큰 없음",
      "blockedCaption": "검문소가 봉투를 열어 봅니다. 쿠키는 있지만 CSRF 토큰이 없습니다. 토큰은 은행 탭의 페이지 안에만 있고, 동일 출처 정책 때문에 함정 탭은 다른 사이트(은행) 페이지의 내용을 읽을 수 없어 토큰을 알아낼 수 없습니다. 403으로 거부합니다.",
      "overrides": [
        {
          "step": 2,
          "title": "세션 쿠키 + CSRF 토큰 발급",
          "caption": "은행이 세션 쿠키를 보내고, 은행 탭의 송금 폼 안에는 CSRF 토큰(열쇠)을 넣어 둡니다. 쿠키는 보관함에, 토큰은 은행 탭 안에만 있습니다.",
          "effects": [
            {
              "type": "store",
              "item": "cookie",
              "into": "jar"
            },
            {
              "type": "give",
              "item": "token",
              "from": "bank",
              "to": "bankTab",
              "label": "CSRF 토큰"
            }
          ]
        },
        {
          "step": 5,
          "effects": [
            {
              "type": "attach",
              "item": "cookie",
              "from": "jar",
              "label": "Cookie"
            },
            {
              "type": "inspect",
              "at": "bank",
              "contents": [
                "POST /transfer",
                "Cookie: session=a91f…",
                "csrf_token: (비어 있음)",
                "보낸 곳: evil.example 탭"
              ],
              "checks": [
                {
                  "name": "쿠키",
                  "result": "있음",
                  "status": "ok"
                },
                {
                  "name": "CSRF 토큰",
                  "result": "없음",
                  "status": "fail"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "SameSite 쿠키",
      "kind": "defense",
      "description": "쿠키에 SameSite=Lax 또는 Strict를 지정하면, 다른 사이트에서 보내는 POST나 하위 요청에는 브라우저가 쿠키를 붙이지 않습니다. 다만 요청 종류와 브라우저에 따라 예외가 있어, CSRF 토큰을 대신하기보다 함께 쓰는 보조 방어입니다.",
      "blockedAtStep": 5,
      "blockedTitle": "쿠키 없는 요청 거부",
      "blockedLabel": "401 · 로그인 필요",
      "blockedCaption": "함정 사이트에서 시작된 POST 요청이라 브라우저가 은행 쿠키를 붙이지 않습니다. 검문소는 로그인하지 않은 요청으로 보고 401로 거부합니다.",
      "overrides": [
        {
          "step": 2,
          "title": "SameSite 쿠키 발급",
          "caption": "은행이 SameSite=Lax를 지정한 세션 쿠키를 보냅니다. Lax 쿠키는 다른 사이트에서 링크를 눌러 이동하는 GET 요청에는 붙지만, 다른 사이트에서 보내는 POST나 이미지·iframe 같은 하위 요청에는 붙지 않습니다.",
          "effects": [
            {
              "type": "store",
              "item": "cookie",
              "into": "jar",
              "label": "SameSite=Lax"
            }
          ]
        },
        {
          "step": 5,
          "effects": [
            {
              "type": "attach",
              "item": "cookie",
              "from": "jar",
              "label": "Cookie",
              "refused": true,
              "reason": "다른 사이트에서 보낸 POST"
            },
            {
              "type": "inspect",
              "at": "bank",
              "contents": [
                "POST /transfer",
                "Cookie: (없음)",
                "to=attacker  amount=1,000,000",
                "보낸 곳: evil.example 탭"
              ],
              "checks": [
                {
                  "name": "쿠키",
                  "result": "없음",
                  "status": "fail"
                }
              ]
            }
          ]
        }
      ]
    }
