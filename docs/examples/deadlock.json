  "defenses": [
    {
      "name": "자원 요청 순서 정하기",
      "kind": "solution",
      "description": "모든 프로세스가 프린터 → 스캐너 순서로만 자원을 요청하게 하면, 서로 상대를 기다리는 순환이 생기지 않습니다.",
      "branchAtStep": 2,
      "steps": [
