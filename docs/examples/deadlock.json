        {
          "action": "release",
          "from": "p1",
          "to": "r1",
          "title": "A가 작업을 마치고 반납",
          "label": "프린터 반납",
          "caption": "A가 작업을 마치고 프린터를 내려놓습니다."
        },
        {
          "action": "acquire",
          "from": "p2",
          "to": "r1",
          "title": "B 진행",
          "label": "프린터 잡음",
          "caption": "기다리던 B가 프린터를 잡고 작업을 이어 갑니다."
        }
